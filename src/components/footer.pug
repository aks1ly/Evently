footer.footer
    .footer__container
        // Ліва частина: логотип і слоган
        .footer__brand
            .footer__logo
                img(src="/images/wine-icon.png" alt="Evently")
                span Evently
            p.footer__description Ваші особливі моменти починаються тут.

        // Навігація
        .footer__navigation
            h3.footer__title Навігація
            a.footer__link(href="#home") Головна
            a.footer__link(href="#locations") Локації
            a.footer__link(href="#services") Послуги
            a.footer__link(href="#about") Про нас

        // Контакти
        .footer__contacts
            h3.footer__title Контакти
            a.footer__contact(href="mailto:info@evently.com")
                img.footer__icon(src="/images/email-icon.png" alt="Пошта")
                span Електронна пошта
            a.footer__contact(href="tel:+380000000000")
                img.footer__icon(src="/images/phone-icon.png" alt="Телефон")
                span Номер телефону
            a.footer__contact(href="https://instagram.com")
                img.footer__icon(src="/images/instagram-icon.png" alt="Instagram")
                span Instagram

        // Нижня частина футера
        .footer__bottom
            p © 2026 Evently. Усі права захищено.
            p Створено з любов'ю ♡
